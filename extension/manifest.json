{
  "manifest_version": 3,
  "name": "Orion Study Assistant",
  "version": "0.1.0",
  "description": "A voice-first study assistant for the page in your active tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Orion"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}